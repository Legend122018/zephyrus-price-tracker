# systemd user service + timer. Install into ~/.config/systemd/user/ then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now zephyrus.timer
[Unit]
Description=ASUS Zephyrus Best Buy price scan
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/zephyrus-price-tracker
Environment=BESTBUY_API_KEY=your_key_here
ExecStart=/usr/bin/python3 -m zephyrus_tracker scan
